# Discord Developer Portal → your application
# Bot tab → Reset Token → paste here. Never send this file to anyone.
DISCORD_TOKEN=

# General Information (or Application ID on the Bot page)
CLIENT_ID=

# Your clan Discord server ID
# Discord → User Settings → Advanced → Developer Mode ON
# Then right-click the server name → Copy Server ID
GUILD_ID=

# In-game clan name (spaces ok). You can also set this later with /setup
CLAN_NAME=

# Full-roster snapshot interval in hours after /setup
SNAPSHOT_HOURS=6
